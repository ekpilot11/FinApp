# Get these from https://dashboard.plaid.com -> Team Settings -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=

# sandbox | production
# "sandbox" uses fake banks and fake data - start here.
PLAID_ENV=sandbox

# Comma-separated ISO country codes your banks are in, e.g. US or GB,IE
PLAID_COUNTRY_CODES=US

# Optional. Leave blank and the first device to connect claims the server.
# Set it to the token shown in FinApp if the server URL might be guessable.
ALLOWED_DEVICE_TOKENS=

PORT=8080
